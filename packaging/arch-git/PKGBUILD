# Maintainer: Salastil <https://github.com/salastil>
pkgname=moho-mail-git
_pkgname=moho-mail
pkgver=0.1.0
pkgrel=1
pkgdesc='Email and calendar client with a four-column layout (Tauri + WebKitGTK)'
arch=('x86_64' 'aarch64')
url='https://github.com/salastil/emailclient'
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsecret' 'sqlite' 'dbus' 'hicolor-icon-theme')
optdepends=('gnome-keyring: stores passwords (or another Secret Service such as KeePassXC or KWallet)'
            'xdg-desktop-portal: native file pickers')
makedepends=('git' 'rust' 'cargo' 'go' 'pnpm' 'nodejs')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto')
# Proton Mail Bridge (GPL-3.0) is compiled into the app; keep in sync with
# crates/proton-bridge-sys/build.rs.
_bridgever=3.27.1
source=("$_pkgname::git+$url.git"
        "proton-bridge::git+https://github.com/ProtonMail/proton-bridge.git#tag=v$_bridgever")
sha256sums=('SKIP' 'SKIP')
_srcdir="$_pkgname"

pkgver() {
  cd "$_srcdir"
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  pnpm install --frozen-lockfile
  export GOPATH="$srcdir/go" GOTOOLCHAIN=auto
  (cd "$srcdir/proton-bridge" && go mod download)
}

build() {
  cd "$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR=target
  export GOPATH="$srcdir/go" GOTOOLCHAIN=auto GOFLAGS="-modcacherw"
  export PROTON_BRIDGE_SRC="$srcdir/proton-bridge" PROTON_BRIDGE_VERSION="$_bridgever"
  # Optional: OAuth clients registered for this build, e.g.
  #   export MOHO_GOOGLE_CLIENT_ID=... MOHO_GOOGLE_CLIENT_SECRET=... MOHO_MICROSOFT_CLIENT_ID=...
  pnpm tauri build --no-bundle --features proton-bridge
}

check() {
  cd "$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo test --frozen -p mail-core -p providers -p pim
}

package() {
  cd "$_srcdir"
  install -Dm755 target/release/moho-mail "$pkgdir/usr/bin/moho-mail"
  install -Dm644 packaging/linux/moho-mail.desktop "$pkgdir/usr/share/applications/moho-mail.desktop"
  install -Dm644 packaging/linux/moho-mail.metainfo.xml "$pkgdir/usr/share/metainfo/moho-mail.metainfo.xml"
  install -Dm644 packaging/linux/moho-mail.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/moho-mail.svg"
  local size
  for size in 32 64 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/moho-mail.png"
  done
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/moho-mail.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
