#!/usr/bin/env bash
# Moho Mail AppImage entry point.
#
# Runs the app inside a bubblewrap sandbox when `bwrap` is available. Inside,
# the system (/usr, /etc) is read-only and almost none of $HOME is visible:
# only Moho Mail's own XDG directories, the Downloads folder, the autostart
# folder, read-only Pictures, Documents and Desktop (to attach files and pick
# account icons), and read-only fonts and themes. Network access (it is a mail client)
# and the session D-Bus (keyring, notifications, tray, portals) are kept.
# Links and attachments open on the host through the desktop portal.
#
#   MOHO_NO_SANDBOX=1           run without the sandbox
#   MOHO_SANDBOX_EXTRA="a:b"    extra host paths (colon-separated) to expose read-write
set -euo pipefail

HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
INNER="$HERE/AppRun.unsandboxed"

if [[ "${MOHO_SANDBOXED:-0}" == 1 || "${MOHO_NO_SANDBOX:-0}" == 1 ]]; then
  exec "$INNER" "$@"
fi
if ! command -v bwrap >/dev/null 2>&1 || ! bwrap --ro-bind / / --unshare-user true 2>/dev/null; then
  echo "moho-mail: bubblewrap (bwrap) is not available or cannot create a sandbox here;" >&2
  echo "moho-mail: running WITHOUT a sandbox. Install bubblewrap to enable it." >&2
  exec "$INNER" "$@"
fi

: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
DOWNLOADS="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
[[ -n "$DOWNLOADS" && "$DOWNLOADS" != "$HOME" ]] || DOWNLOADS="$HOME/Downloads"

writable=(
  "$XDG_CONFIG_HOME/moho-mail" "$XDG_CACHE_HOME/moho-mail" "$XDG_DATA_HOME/moho-mail"
  "$XDG_STATE_HOME/moho-mail" "$XDG_CONFIG_HOME/autostart" "$DOWNLOADS"
)
mkdir -p "${writable[@]}"

args=(
  --unshare-all --share-net --die-with-parent --new-session
  --ro-bind /usr /usr
  --ro-bind-try /bin /bin --ro-bind-try /sbin /sbin
  --ro-bind-try /lib /lib --ro-bind-try /lib64 /lib64 --ro-bind-try /lib32 /lib32
  --ro-bind /etc /etc
  --ro-bind-try /opt /opt
  --ro-bind /sys /sys
  --proc /proc
  --dev /dev
  --dev-bind-try /dev/dri /dev/dri
  --tmpfs /tmp
  --ro-bind-try /tmp/.X11-unix /tmp/.X11-unix
  --tmpfs /run
  --ro-bind-try /run/dbus /run/dbus
  --ro-bind-try /run/systemd/resolve /run/systemd/resolve
  --tmpfs /home
  --dir "$HOME"
  --dir "$XDG_RUNTIME_DIR" --chmod 0700 "$XDG_RUNTIME_DIR"
  --bind-try "$XDG_RUNTIME_DIR/bus" "$XDG_RUNTIME_DIR/bus"
  --bind-try "$XDG_RUNTIME_DIR/at-spi" "$XDG_RUNTIME_DIR/at-spi"
  --bind-try "$XDG_RUNTIME_DIR/dconf" "$XDG_RUNTIME_DIR/dconf"
  --ro-bind-try "$HOME/.Xauthority" "$HOME/.Xauthority"
)
# The AppImage itself (mounted under /tmp, which is now a private tmpfs).
args+=(--ro-bind "$HERE" "$HERE")
[[ -n "${APPIMAGE:-}" && -e "$APPIMAGE" ]] && args+=(--ro-bind "$APPIMAGE" "$APPIMAGE")
for d in "${writable[@]}"; do
  args+=(--bind "$d" "$d")
done
for d in "$XDG_CONFIG_HOME/user-dirs.dirs" "$XDG_CONFIG_HOME/fontconfig" "$XDG_CONFIG_HOME/gtk-3.0" \
         "$XDG_CONFIG_HOME/dconf" "$XDG_DATA_HOME/fonts" "$XDG_DATA_HOME/icons" "$XDG_DATA_HOME/themes" \
         "$HOME/.fonts" "$HOME/.icons" "$HOME/.themes"; do
  args+=(--ro-bind-try "$d" "$d")
done
# The session bus may live outside $XDG_RUNTIME_DIR (e.g. dbus-launch uses /tmp).
# Abstract sockets need nothing: the network namespace is shared.
IFS=';' read -r -a bus_addrs <<< "${DBUS_SESSION_BUS_ADDRESS:-}"
for addr in "${bus_addrs[@]}"; do
  if [[ "$addr" == unix:*path=* ]]; then
    bus="${addr#*path=}"; bus="${bus%%,*}"
    args+=(--bind-try "$bus" "$bus")
  fi
done
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  if [[ "$WAYLAND_DISPLAY" == /* ]]; then sock="$WAYLAND_DISPLAY"; else sock="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"; fi
  args+=(--bind-try "$sock" "$sock")
fi
if [[ -n "${XAUTHORITY:-}" && -e "$XAUTHORITY" ]]; then
  args+=(--ro-bind "$XAUTHORITY" "$XAUTHORITY")
fi
# Folders the file picker may open from, read-only.
for pair in PICTURES:Pictures DOCUMENTS:Documents DESKTOP:Desktop; do
  d="$(xdg-user-dir "${pair%%:*}" 2>/dev/null || true)"
  # xdg-user-dir answers $HOME for folders that were never configured.
  [[ -n "$d" && "$d" != "$HOME" ]] || d="$HOME/${pair#*:}"
  [[ "$d" != "$DOWNLOADS" ]] && args+=(--ro-bind-try "$d" "$d")
done
IFS=: read -r -a extra <<< "${MOHO_SANDBOX_EXTRA:-}"
for p in "${extra[@]}"; do
  [[ -n "$p" && -e "$p" ]] && args+=(--bind "$p" "$p")
done
args+=(--setenv MOHO_SANDBOXED 1)

exec bwrap "${args[@]}" -- "$INNER" "$@"
